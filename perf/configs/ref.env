# Reference configuration (HANDOVER section 2; PERF-04). Sourced by perf/run_pipeline.sh.
# Hardware is fixed for every run set and is NOT set here: emr-7.10.0, 1 primary + 2 core m5.xlarge,
# one 100 GiB gp3 volume per core node (D-015), dfs.replication=2, no task nodes, no autoscaling.
# EMR enables Spark dynamic allocation by default, so it is switched off explicitly.
CONFIG_NOTE="reference: 2 executors x 2 cores x 6 GiB heap + 2 GiB overhead, 2 GiB driver, dynamic allocation off"
SPARK_OPTS="--conf spark.dynamicAllocation.enabled=false --num-executors 2 --executor-cores 2 --executor-memory 6g --conf spark.executor.memoryOverhead=2g --driver-memory 2g"
