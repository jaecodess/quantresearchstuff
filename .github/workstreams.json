{
  "_comment": "Single source of truth for who owns what. Set each owner to a real GitHub handle, then run `make codeowners`. Longest matching path prefix wins; unmatched paths are 'shared'.",
  "exempt_paths": ["docs/progress/"],
  "shared_file": "docs/progress/team.md",
  "workstreams": {
    "TEAM": {
      "name": "Shared / team",
      "file": "docs/progress/team.md",
      "owner": "@TODO",
