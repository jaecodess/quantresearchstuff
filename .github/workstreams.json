      "owner": "@TODO",
      "cross_reviewers": ["PIPE"],
      "paths": ["corpus/", "manifests/", "docs/corpus/", "tests/corpus/"]
    },
    "PIPE": {
      "name": "Pipeline (Task 2)",
      "file": "docs/progress/pipeline.md",
      "owner": "@TODO",
      "cross_reviewers": ["MODEL"],
      "paths": ["streaming/", "hive/", "spark/", "config/split_events.csv", "tests/pipeline/", "tests/spark/"]
    },
    "MODEL": {
      "name": "Model (Task 3)",
      "file": "docs/progress/model.md",
      "owner": "@TODO",
      "cross_reviewers": ["PIPE"],
      "paths": ["modeling/", "evaluation/", "models/", "tests/model/"]
    },
    "ANLY": {
      "name": "Analytics (Task 4)",
      "file": "docs/progress/analytics.md",
      "owner": "@TODO",
      "cross_reviewers": ["MODEL"],
      "paths": ["analytics/", "tests/analytics/"]
    },
    "PERF": {
      "name": "Performance & reproducibility",
      "file": "docs/progress/performance.md",
      "owner": "@TODO",
      "cross_reviewers": ["CORP"],
      "paths": ["perf/", "evidence/", "notebooks/", "docs/rerun/", "tests/perf/"]
    }
  }
}
